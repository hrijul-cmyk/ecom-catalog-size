{
  "name": "ecom-catalog-size",
  "version": "0.1.0",
  "description": "Estimate an ecommerce store's catalog size (product count) from a CSV of domains — open product APIs where available, sitemap counting otherwise. No AI in the counting loop.",
  "type": "module",
  "bin": {
    "catalog-size": "src/cli.ts"
  },
  "scripts": {
    "catalog-size": "tsx src/cli.ts",
    "typecheck": "tsc --noEmit",
    "build": "tsc"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "dotenv": "^16.4.5",
    "p-limit": "^6.1.0",
    "papaparse": "^5.4.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/papaparse": "^5.3.15",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
