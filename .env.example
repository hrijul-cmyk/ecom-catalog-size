# The CLI needs no secrets — every probe hits public store endpoints.
# These are all optional.

# Override the default User-Agent used for probing.
# CATALOG_USER_AGENT="Mozilla/5.0 (catalog-size-estimator)"

# Global concurrency (number of domains probed in parallel). Default 10.
# CATALOG_CONCURRENCY=10

# --- HTTP API (src/server.ts) ---
# Port the API listens on. Railway sets PORT automatically; default 8080 locally.
# PORT=8080

# If set, the /estimate endpoints require  Authorization: Bearer <key>.
# Leave unset to run the endpoint open (matches other internal services).
# CATALOG_API_KEY=

# --- v2 (not used yet) ---
# PROXY_URL=
