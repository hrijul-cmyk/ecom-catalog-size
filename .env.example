# No secrets are required for the MVP — every probe hits public store endpoints.
# This file exists for convention and future use (v2 proxy pool / API keys).

# Optional: override the default User-Agent used for probing.
# CATALOG_USER_AGENT="Mozilla/5.0 (catalog-size-estimator)"

# Optional: global concurrency (number of domains probed in parallel). Default 10.
# CATALOG_CONCURRENCY=10

